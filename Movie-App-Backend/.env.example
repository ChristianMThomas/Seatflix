# Server Configuration
# Railway will set PORT automatically - only set this for local development
# PORT=8080

# Database Configuration
#
# OPTION 1: PostgreSQL (Railway default)
# Railway automatically provides DATABASE_URL - no need to set DB_URL manually!
# Format: postgresql://user:pass@host:port/dbname
# If using Railway PostgreSQL, just set these in Railway dashboard:
# DATABASE_URL=<provided by Railway>
#
# For local PostgreSQL development:
# DB_URL=jdbc:postgresql://localhost:5432/seatflix
# DB_USERNAME=postgres
# DB_PASSWORD=your_database_password
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
#
# OPTION 2: MySQL (for local development)
DB_URL=jdbc:mysql://localhost:3306/seatflix
DB_USERNAME=root
DB_PASSWORD=your_database_password
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT Configuration
# Generate a secure secret key (at least 32 characters)
# IMPORTANT: Use a strong random key in production!
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRATION=86400000

# CORS Configuration
# Comma-separated list of allowed origins
# Production domains for SeatFlix by ITT (Infinite Tech Team)
ALLOWED_ORIGINS=http://localhost:5173,https://seatflix.infinitetechteam.com

# Cloudflare R2 (avatar storage)
# Dashboard > R2 > your bucket. Account ID is on the R2 overview page.
# API token: R2 > Manage API tokens > "Object Read & Write" scoped to this bucket.
# Public URL: bucket Settings > Public access (r2.dev subdomain or custom domain), no trailing slash.
# Leave these unset to run without avatar uploads.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=seatflix-avatars
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev

# Optional: Development/Debug Settings (keep these disabled in production)
# SHOW_SQL=true
# FORMAT_SQL=true
# APP_LOG_LEVEL=DEBUG
